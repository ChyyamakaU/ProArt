# Runtime environment: development | test | production
NODE_ENV=development

# HTTP server port
PORT=4000

# PostgreSQL connection string (local or cloud Postgres)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/skillverify

# Enable TLS/SSL for cloud PostgreSQL providers (true | false)
DATABASE_SSL=false

# Set to true only if your cloud Postgres uses a self-signed certificate
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Comma-separated whitelist of allowed CORS origins (never use * in production)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Public frontend base URL used to construct shareable Trust Card WhatsApp links
FRONTEND_URL=http://localhost:5173

# Strong HMAC signing secret for JWT tokens (minimum 32 characters; generate with: openssl rand -hex 32)
JWT_SECRET=replace-with-a-cryptographically-random-secret-at-least-32-chars

# JWT access token expiration duration (e.g., 15m, 12h, 7d)
JWT_EXPIRES_IN=7d

# Local directory where verified work sample images are stored
UPLOAD_DIR=./uploads

# Express trust proxy setting (0 for direct, 1 behind a single reverse proxy like Nginx/Render)
TRUST_PROXY=0
