{
  "name": "skillverify-backend",
  "version": "1.0.0",
  "description": "Production-grade, hardened REST API for SkillVerify — informal worker digital identity and skills verification platform.",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:migrate": "node src/db/runSql.js schema.sql",
    "db:seed": "node src/db/runSql.js seed.sql",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "demo:verification": "node demo/verification.js",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.0",
    "pg": "^8.14.1",
    "sharp": "^0.34.5",
    "zod": "^4.6.7"
  }
}
